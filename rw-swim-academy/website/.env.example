# Copy to .env for local `netlify dev`, and add the same keys in Netlify > Site settings > Environment variables.

# --- Site ---
SITE_URL=https://rwswimacademy.co.uk
ACADEMY_EMAIL=hello@rwswimacademy.co.uk         # where booking notifications go (Ruby/Chris)
ACADEMY_PHONE=07xxx xxxxxx

# --- Stripe (dashboard.stripe.com > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                # from Developers > Webhooks after adding the endpoint /api/stripe-webhook

# --- Google Calendar (a service account with the academy calendar shared to it with "Make changes to events") ---
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# --- Email (resend.com; free tier is plenty to start) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="RW Swim Academy <hello@rwswimacademy.co.uk>"

# --- Optional: timezone used for slots ---
TIMEZONE=Europe/London
