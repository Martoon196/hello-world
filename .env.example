# Copy to .env on the VPS and fill in. NEVER commit real values.

# --- Telegram (ingestion: user session from my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=betbot

# --- Telegram (notifications: bot token from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your personal chat id with the bot (message the bot, then https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_ADMIN_CHAT_ID=

# --- Anthropic (tip parsing) ---
ANTHROPIC_API_KEY=

# --- Betfair (delayed app key: free, for market lookup + results; NOT for placing bets in v1) ---
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=

# --- Feed & webhook secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
FEED_TOKEN=
WHATSAPP_WEBHOOK_TOKEN=
BFBM_RESULTS_TOKEN=

# --- Dashboard login (username is always 'betbot') ---
DASHBOARD_PASSWORD=

# --- Paths / server ---
BETBOT_DB_PATH=data/betbot.db
BETBOT_HOST=0.0.0.0
BETBOT_PORT=8080
