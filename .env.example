# Copy this file to ".env" and fill in values.

# --- Database ---
# Local dev uses SQLite (a single file). For production (Vercel/Render),
# swap to a Postgres URL and change the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- AI (optional) ---
# When set, lead qualification summaries and follow-up email drafts are
# generated by Claude. When blank, the app falls back to the deterministic
# scoring engine and template emails — everything still works.
ANTHROPIC_API_KEY=""
