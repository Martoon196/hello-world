# Required in production (not needed when MOCK_ANALYSIS=1)
ANTHROPIC_API_KEY=sk-ant-...

# Model used to read deal sheets. Default: claude-opus-5
# ANTHROPIC_MODEL=claude-opus-5

# Password for the /dashboard.html review screen (username is "admin").
# If unset, the dashboard is open - only do that on a private network.
DASHBOARD_PASSWORD=change-me

# Optional: require sourcers to include this token (?token=... on the form URL)
# SUBMIT_TOKEN=

# Optional: where deals and uploads are stored. Default: ./data
# DATA_DIR=./data

# Set to 1 to run without an API key using a canned analysis (for testing the UI)
# MOCK_ANALYSIS=1

PORT=3000
